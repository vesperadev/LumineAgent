{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LumineAgent",
  "version": "0.1.0",
  "identifier": "dev.lumineagent.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5317",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "LumineAgent",
        "width": 1100,
        "height": 750,
        "minWidth": 640,
        "minHeight": 480,
        "decorations": false,
        "visible": false,
        "backgroundColor": "#fafafa"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERDODk1RkFFNDFFRjhCMzgKUldRNGkrOUJybCtKM0lwU2Q3N05XanlkY2JQNkN3NEhGcVV6L1JPVm1ZYWh2ODJrTjk2ajhOL2UK",
      "endpoints": [
        "https://github.com/vesperadev/LumineAgent/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
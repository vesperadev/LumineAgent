{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LumineAgent",
  "version": "0.1.0",
  "identifier": "dev.lumineagent.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5317",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "LumineAgent",
        "width": 1100,
        "height": 750,
        "minWidth": 640,
        "minHeight": 480,
        "decorations": false,
        "visible": false,
        "backgroundColor": "#fafafa"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}